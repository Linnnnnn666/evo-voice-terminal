+bool WebsocketProtocol::IsAudioChannelOpened() const {
+    std::lock_guard<std::mutex> lock(websocket_mutex_);
+    return websocket_ != nullptr && websocket_->IsConnected() && hello_received_ &&
+           !error_occurred_ && !IsTimeout();
+}
+
+bool WebsocketProtocol::OpenAudioChannel() {
+    // If the keep-alive connection is already live, it doubles as the audio
+    // channel: the server accepts audio on the established session.
+    if (IsAudioChannelOpened()) {
+        return true;
+    }
+
+    // Wait for an in-flight keep-alive connect attempt (if any) to settle.
+    if (connecting_.load()) {
+        int waited_ms = 0;
+        while (connecting_.load() && waited_ms < 12000) {
+            vTaskDelay(pdMS_TO_TICKS(100));
+            waited_ms += 100;
+        }
+        if (IsAudioChannelOpened()) {
+            return true;
+        }
+    }
+
+    // Try to connect ourselves; only one connector may run at a time.
+    if (!connecting_.exchange(true)) {
+        bool ok = ConnectAndHandshake(true);
+        if (ok && on_audio_channel_opened_ != nullptr) {
+            on_audio_channel_opened_();
+        }
+        connecting_ = false;
+        return ok;
+    }
+
+    // A keep-alive attempt started right after our check; wait once more.
+    int waited_ms = 0;
+    while (connecting_.load() && waited_ms < 12000) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+        waited_ms += 100;
+    }
+    return IsAudioChannelOpened();
+}
+
+void WebsocketProtocol::CloseAudioChannel(bool send_goodbye) {
+    (void)send_goodbye;  // Websocket doesn't need to send goodbye message
+    std::shared_ptr<WebSocket> old;
+    {
+        std::lock_guard<std::mutex> lock(websocket_mutex_);
+        old = std::move(websocket_);
+        hello_received_ = false;
+    }
+    old.reset();  // may block in the Tcp destructor; lock not held
+    // The destructor no longer fires the callback for a detached connection,
+    // so fire it explicitly.
+    if (on_audio_channel_closed_ != nullptr) {
+        on_audio_channel_closed_();
+    }
+}
