+void WebsocketProtocol::KeepAliveTask() {
+    ESP_LOGI(TAG, "Keep-alive task started");
+    TickType_t wait = pdMS_TO_TICKS(2000);  // first attempt shortly after boot
+    while (keep_alive_running_.load()) {
+        // Sleep in 1s slices so the task can exit promptly on shutdown.
+        while (wait > 0 && keep_alive_running_.load()) {
+            TickType_t slice = (wait > pdMS_TO_TICKS(1000)) ? pdMS_TO_TICKS(1000) : wait;
+            vTaskDelay(slice);
+            wait -= slice;
+        }
+        if (!keep_alive_running_.load()) {
+            break;
+        }
+        wait = pdMS_TO_TICKS(kKeepAliveReconnectDelayMs);
 
